# 复制为 .env 后填写；.env 不要提交到仓库
# 企业微信自建应用（发给个人）：企业微信后台 → 我的企业 → 企业信息 → 企业 ID
WECOM_CORP_ID=
# 应用详情页 AgentId 右侧「查看」得到的 Secret（不是接收消息的 Token/EncodingAESKey）
WECOM_SECRET=
# 应用详情页的 AgentId
WECOM_AGENT_ID=1000004
# 接收人：@all 表示应用可见范围内的全部成员；也可填 UserID，多个用 | 分隔
WECOM_TOUSER=@all
# 可选：按部门/标签发送，填 ID，多个用 | 分隔
WECOM_TOPARTY=
WECOM_TOTAG=

# 群机器人 webhook（可选旧方案；与自建应用同时配置时优先自建应用）
WECOM_WEBHOOK=

# 下载前要求目标媒体目录至少剩余多少 GB，低于则拒绝提交；0 表示关闭检查
MEDIA_MIN_FREE_GB=20
