[Unit]
Description=MCSManager Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/mcsmanager/daemon
ExecStart=/usr/local/bin/node --max-old-space-size=2048 --enable-source-maps app.js
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
