[Unit]
Description=MCSManager Web Panel
After=network-online.target mcsm-daemon.service
Wants=network-online.target mcsm-daemon.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/mcsmanager/web
ExecStart=/usr/local/bin/node --max-old-space-size=1024 --enable-source-maps app.js
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
